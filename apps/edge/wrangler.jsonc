{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "owl-park",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // No compatibility flags: the Worker uses only Web APIs (WebSocket, Web Crypto, Durable Object
  // SQLite). Wrangler reports Node.js compatibility as on at this date; nothing imports node: modules.
  // The built client is served as static assets by the same Worker (free, unlimited).
  // Build it first: pnpm --filter @owl-park/park build  (with VITE_TRANSPORT=edge).
  "assets": {
    "directory": "../park/dist",
    "binding": "ASSETS",
    // The API, the sockets and the page itself reach the Worker first; the page is served uncached
    // (src/page.ts), so a deploy never leaves a cached page pointing at a script bundle that is gone.
    // /admin/* holds the keepers' pages (src/feedbackPage.ts).
    "run_worker_first": ["/ws/*", "/api/*", "/admin/*", "/", "/index.html"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      { "name": "VOTES", "class_name": "VoteLedger" },
      // Every collector's collectibles (finds, feathers, home time zone): one object for the park.
      { "name": "COLLECTIONS", "class_name": "Collections" },
      // Busy nights (OP-075): the line in front of the park, the busy ribbon and copies of rooms, with
      // their settings: one object for the park (src/Overflow.ts).
      { "name": "OVERFLOW", "class_name": "Overflow" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomObject"] },
    { "tag": "v2", "new_sqlite_classes": ["VoteLedger"] },
    { "tag": "v3", "new_sqlite_classes": ["Collections"] },
    { "tag": "v4", "new_sqlite_classes": ["Overflow"] }
  ],
  // The park's domain, attached to this Worker as Custom Domains on every deploy, so nothing else can
  // stand in front of it (Cloudflare keeps the DNS records and the certificates). A hostname that
  // still has DNS records of its own (A, AAAA, CNAME) cannot be attached: delete those first.
  "routes": [
    { "pattern": "exploreowlpark.com", "custom_domain": true },
    { "pattern": "www.exploreowlpark.com", "custom_domain": true }
  ],
  // Keep the workers.dev address on beside the domain: with routes listed, Wrangler switches it off
  // unless this says otherwise.
  "workers_dev": true,
  // Month close for the Realm Vote: 05:05 UTC on the 1st (just after midnight in the park's time zone).
  // Hourly: orders the fraud check held past their 24 hours are released (C45; nothing to do until
  // the fraud link has held one).
  "triggers": { "crons": ["5 5 1 * *", "17 * * * *"] },
  "vars": {
    // "single": the whole park lives in one Durable Object (cheapest on the free tier).
    // "room": one object per room (more fan-out capacity, more awake-time billed).
    "ROOM_SHARDING": "single",
    // Every visitor arrives in the lobby. "open": the turnstiles let everyone through. "ticket"
    // (once tickets sell): only a pass the gate admitted with a ticket goes beyond the lobby.
    "GATE": "open",
    // Sockets per client address per object. Households and offices share one address.
    "MAX_SOCKETS_PER_IP": "8",
    // The park's calendar for the Realm Vote (one vote per person per park day).
    "PARK_TZ": "America/New_York",
    // Standings stay private until the owner decides otherwise; admin routes need: wrangler secret put ADMIN_KEY
    "VOTE_TALLY_PUBLIC": "false"
    // Optional: "ROOM_CAPS": "{\"hub\":80,\"grove\":40,\"market\":40}"
    // Local load tests only: run  wrangler dev --var TRUST_FORWARDED_FOR:true  so the swarm's --ip-header works.
  },
  // Secrets (PASS_SIGNING_KEY, ADMIN_KEY) are set with `wrangler secret put`, never written here,
  // and are deliberately not declared as `secrets.required`: that would refuse the first deploy of
  // a new Worker until both exist, while the Worker runs with a development key (and a logged
  // warning) until they are set. The store's (SHOPIFY_SHOP, the app's SHOPIFY_CLIENT_ID and
  // SHOPIFY_CLIENT_SECRET or an older app's SHOPIFY_ADMIN_TOKEN, and SHOPIFY_WEBHOOK_SECRET) are set
  // the same way once the store's app exists; until then the ticket webhooks are refused. So is
  // OPENING_PASS_CODE, opening night's code for the annual pass at half price (C42, OP-062), and the
  // fraud link's FRAUD_SCORE_URL, FRAUD_SCORE_KEY and FRAUD_HASH_SALT (C45). All are typed as
  // optional in src/env.ts.
  // Workers Logs and Traces (free tier included). Traces are sampled; logs are kept whole.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
