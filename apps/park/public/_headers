# OP-129: the script bundles are named by their content, and the art is asked for with its content's
# hash (?v=, from vite.config.ts), so both are kept a year; a changed file is a new address. The page
# itself is never kept (the Worker serves it uncached: apps/edge/src/page.ts).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/art/*
  Cache-Control: public, max-age=31536000, immutable
# OP-140: every file goes out as the type it is named for, and over https only once a browser has
# been here (the Worker's own answers carry the same: apps/edge/src/guard.ts).
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
