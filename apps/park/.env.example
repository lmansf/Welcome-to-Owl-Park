# Copy to .env.local for local development. All values are public (they ship in the browser bundle).
# Leave VITE_SUPABASE_URL empty to run with the zero-backend local transport (multiplayer across tabs on one device).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional link for the gift shop door. Leave empty until the store opens.
VITE_SHOP_URL=
# Room server (authoritative multiplayer). VITE_TRANSPORT=edge uses the page's own origin
# (when the Worker serves the client); VITE_EDGE_URL points at a Worker hosted elsewhere.
VITE_TRANSPORT=
VITE_EDGE_URL=
# Rooms are rasterized at up to this many texture pixels per room pixel on high-density phones (1 to 2; default 1.5).
VITE_ART_SCALE_MAX=
